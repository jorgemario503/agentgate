# =============================================================================
# agentgate — environment variables
# Copy this file to .env and fill in the values you need.
# Lines starting with # are comments. Optional vars can be left blank or omitted.
# =============================================================================


# -----------------------------------------------------------------------------
# SLACK  (required if running run.py --slack)
# Get your tokens at https://api.slack.com/apps
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...         # required for Socket Mode
ALLOWED_SLACK_USER_IDS=          # comma-separated Slack member IDs; empty = open to all
ADMIN_SLACK_USER_IDS=            # comma-separated; empty = approve/reject disabled
SLOW_RESPONSE_EMOJI=turtle       # Slack reaction name (no colons) shown after SLOW_RESPONSE_SECONDS


# -----------------------------------------------------------------------------
# TELEGRAM — default bot  (required if running run.py --telegram without --bot)
# Create a bot at https://t.me/BotFather and copy the token it gives you.
# Get your Telegram user ID: message @userinfobot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=       # comma-separated Telegram user IDs; empty = open to all
ADMIN_TELEGRAM_USER_IDS=         # comma-separated; empty = approve/reject disabled
TELEGRAM_THINKING_REACTION=🤔    # reaction shown while the bot is working
TELEGRAM_SLOW_RESPONSE_REACTION=🐳  # swapped in after SLOW_RESPONSE_SECONDS


# -----------------------------------------------------------------------------
# TELEGRAM — named bot identities  (one block per extra bot, e.g. --bot work)
# Token is required and must be unique — two bots CANNOT share a token.
# ALLOWED_/ADMIN_ vars fall back to the unsuffixed vars above if not set.
# Run `python run.py --list-bots` to verify isolation before launch.
# Add the agent to permissions.yaml too (see README for steps).
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN_WORK=
# ALLOWED_TELEGRAM_USER_IDS_WORK=
# ADMIN_TELEGRAM_USER_IDS_WORK=

# TELEGRAM_BOT_TOKEN_PERSONAL=
# ALLOWED_TELEGRAM_USER_IDS_PERSONAL=
# ADMIN_TELEGRAM_USER_IDS_PERSONAL=


# -----------------------------------------------------------------------------
# WHATSAPP — linked device via wppconnect-server  (run.py --whatsapp)
# See README for wppconnect-server setup steps.
# -----------------------------------------------------------------------------
WPPCONNECT_SERVER_URL=http://localhost:8082   # URL of your wppconnect-server instance
WPPCONNECT_SESSION=default                    # session name (arbitrary; one device = one session)
WPPCONNECT_WEBHOOK_URL=http://localhost:8081/webhook  # public URL wppconnect-server calls back
WHATSAPP_LINKED_PORT=8081                     # port this bot's FastAPI server listens on
ALLOWED_WHATSAPP_USER_IDS=                    # comma-separated phone numbers; empty = open to all
ADMIN_WHATSAPP_USER_IDS=                      # comma-separated; empty = approve/reject disabled
WHATSAPP_BACKEND=claude                       # claude | fireworks | ollama | mlx
WHATSAPP_MODEL=                               # optional model override (for fireworks/ollama/mlx)


# -----------------------------------------------------------------------------
# RUNNER — Claude (default; requires `claude` CLI on PATH and logged in)
# RUNNER — Fireworks  (python run.py --telegram fireworks)
# -----------------------------------------------------------------------------
FIREWORKS_API_KEY=               # required for --fireworks
FIREWORKS_MODEL=                 # optional; defaults to Kimi K2 (minimax-m3)
FIREWORKS_TEMPERATURE=0.2
FIREWORKS_MAX_TOKENS=4096


# -----------------------------------------------------------------------------
# RUNNER — Ollama  (python run.py --telegram ollama)
#
# Same machine:
#   OLLAMA_BASE_URL=http://localhost:11434/v1   (default Ollama port)
#   OLLAMA_BASE_URL=http://localhost:8081/v1    (if you changed OLLAMA_HOST in launchd)
#
# Different machine via Tailscale:
#   1. On the server: set OLLAMA_HOST=0.0.0.0:<port> in your launchd plist
#   2. Install Tailscale on both machines; note the server's Tailscale IP (100.x.x.x)
#   3. OLLAMA_BASE_URL=http://100.x.x.x:<port>/v1
#   Note: Ollama has no built-in API key auth — use Tailscale ACLs to restrict
#   which peers can reach the port, or put nginx/Caddy in front for key auth.
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=                    # required; e.g. qwen3:14b
OLLAMA_API_KEY=                  # optional; set if you added a proxy with auth
OLLAMA_CONTEXT_WINDOW=32768
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=4096
OLLAMA_SUMMARY_MODEL=            # optional; cheaper model for history compaction


# -----------------------------------------------------------------------------
# RUNNER — MLX  (python run.py --telegram mlx)
# Uses python -m mlx_lm.server (OpenAI-compatible). Can also point at any
# other OpenAI-compatible local server (llama.cpp, LM Studio, etc.).
#
# Same machine — start the server first:
#   /path/to/venv/bin/python -m mlx_lm.server \
#     --host 127.0.0.1 --port 8082 \
#     --model mlx-community/Qwen3-14B-4bit \
#     --api-key your_secret_key
#   Then: MLX_BASE_URL=http://localhost:8082/v1
#
# Different machine via Tailscale:
#   1. Start the server on the remote machine with --host 0.0.0.0:
#      /path/to/venv/bin/python -m mlx_lm.server \
#        --host 0.0.0.0 --port 8082 \
#        --model mlx-community/Qwen3-14B-4bit \
#        --api-key $(openssl rand -hex 32)
#   2. Install Tailscale on both machines; note the server's Tailscale IP (100.x.x.x)
#   3. MLX_BASE_URL=http://100.x.x.x:8082/v1  and  MLX_API_KEY=<same key>
#
# Tip: manage the server as a launchd service — see README for a sample plist.
# -----------------------------------------------------------------------------
MLX_BASE_URL=http://localhost:8082/v1
MLX_MODEL=                       # required; e.g. mlx-community/Qwen3-14B-4bit
MLX_API_KEY=                     # optional same-machine; required cross-machine
MLX_CONTEXT_WINDOW=32768
MLX_TEMPERATURE=0.2
MLX_MAX_TOKENS=4096
MLX_SUMMARY_MODEL=               # optional


# -----------------------------------------------------------------------------
# CORE BEHAVIOR
# -----------------------------------------------------------------------------
IDLE_TIMEOUT_SECONDS=28800       # 8h — idle sessions are closed and the user notified
APPROVAL_TIMEOUT_SECONDS=14400   # 4h — unanswered permission prompts auto-deny
SLOW_RESPONSE_SECONDS=60         # seconds before the "still thinking" reaction appears
ADDITIONAL_DIRS=                 # comma-separated absolute paths the agent can read/write freely


# -----------------------------------------------------------------------------
# AGENTDB  (governed long-term memory — optional, disabled by default)
# Set AGENTDB_ENABLED=true and fill in the paths to enable.
# -----------------------------------------------------------------------------
AGENTDB_ENABLED=false
AGENTDB_PATH=agent-sessions/agentdb.db
AGENTDB_MEMORY_DIR=agentdb-workspace
AGENTDB_PERMISSIONS_PATH=permissions.yaml
