{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentgate/handoff.schema.json",
  "title": "Handoff request",
  "description": "Contract for a request to transfer execution between roles. Encodes spec section 4.1 of the reconciled orchestration spec. Validated by core.orchestration.validate.validate_handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "milestone_id",
    "attempt_id",
    "handoff_id",
    "idempotency_key",
    "source_role",
    "target_role",
    "requested_action",
    "spec_version",
    "base_commit",
    "candidate_commit",
    "artifact_references",
    "created_at",
    "requested_by",
    "authorization_status"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "workflow_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "spec_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "milestone_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "handoff_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source_role": { "type": "string", "enum": ["implementer", "reviewer"] },
    "target_role": { "type": "string", "enum": ["implementer", "reviewer"] },
    "requested_action": {
      "type": "string",
      "enum": ["review_milestone", "apply_fixes"]
    },
    "spec_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "requested_by": { "type": "string", "minLength": 1, "maxLength": 128 },
    "authorization_status": {
      "type": "string",
      "enum": ["pending_human_approval", "approved", "denied", "cancelled", "expired"]
    }
  }
}
